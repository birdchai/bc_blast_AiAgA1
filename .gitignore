# Track this repository from the updated-data research phase onward.
# Raw data stays local; reproducible logic, documentation, and compact
# governance outputs are tracked.

# Ignore everything by default, then allowlist project files below.
*

# Git controls
!.gitignore
!.gitattributes

# Research documentation
!*.md
!docs/
!docs/**/*.md

# Source code
!main.py
!agents/
!agents/**/*.py
!tools/
!tools/**/*.py
!workflows/
!workflows/**/*.py

# Updated-data phase experiment scripts
!experiments/
experiments/*
!experiments/outputs/
!experiments/audit_updated_data.py
!experiments/audit_updated_data_content.py
